    inputName.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    inputName.TextSize = 11
    inputName.Parent = cardFrame

    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 4)
    inputCorner.Parent = inputName

    local fullNameLabel = Instance.new("TextLabel")
    fullNameLabel.Size = UDim2.new(0, 130, 0, 20)
    fullNameLabel.Position = UDim2.new(0, 165, 0, 7)
    fullNameLabel.BackgroundTransparency = 1
    fullNameLabel.Text = "---"
    fullNameLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
    fullNameLabel.TextSize = 12
    fullNameLabel.Font = Enum.Font.SourceSansBold
    fullNameLabel.TextXAlignment = Enum.TextXAlignment.Left
    fullNameLabel.Parent = cardFrame

    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, -65, 0, 25)
    statsLabel.Position = UDim2.new(0, 58, 0, 30)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Text = "دخول: 0  |  خروج: 0   المدة: 00H 00m 00s"
    statsLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    statsLabel.TextSize = 11
    statsLabel.Font = Enum.Font.SourceSans
    statsLabel.TextXAlignment = Enum.TextXAlignment.Left
    statsLabel.Parent = cardFrame

    -- بيانات التتبع الدقيقة
    local targetUserId = nil
    local targetName = ""
    local joins = 0
    local exits = 0
    local timerSeconds = 0
    local isTracking = false
    local playerImgUrl = ""

    -- البحث بالكتابة والتحديد عبر الـ UserId
    inputName:GetPropertyChangedSignal("Text"):Connect(function()
        local text = inputName.Text
        if #text >= 3 then
            for _, plr in ipairs(Players:GetPlayers()) do
                if string.sub(string.lower(plr.Name), 1, #text) == string.lower(text) or string.sub(string.lower(plr.DisplayName), 1, #text) == string.lower(text) then
                    targetUserId = plr.UserId
                    targetName = plr.Name
                    fullNameLabel.Text = plr.Name
                    playerImgUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. plr.UserId .. "&width=420&height=420&format=png"
                    userImage.Image = playerImgUrl
                    
                    joins = 0
                    exits = 0
                    timerSeconds = 0
                    isTracking = true
                    
                    statsLabel.Text = "دخول: " .. joins .. "  |  خروج: " .. exits .. "   " .. formatTime(timerSeconds)
                    break
                end
            end
        end
    end)

    -- عداد الوقت المستمر
    task.spawn(function()
        while true do
            task.wait(1)
            if isTracking and targetUserId then
                local plr = Players:GetPlayerByUserId(targetUserId)
                if plr then
                    timerSeconds = timerSeconds + 1
                    statsLabel.Text = "دخول: " .. joins .. "  |  خروج: " .. exits .. "   " .. formatTime(timerSeconds)
                end
            end
        end
    end)

    -- تتبع الخروج الدقيق بدلالة الـ UserId
    Players.PlayerRemoving:Connect(function(plr)
        if targetUserId and plr.UserId == targetUserId then
            exits = exits + 1
            isTracking = false
            local frozenTimeStr = formatTime(timerSeconds)
            statsLabel.Text = "دخول: " .. joins .. "  |  خروج: " .. exits .. "   " .. frozenTimeStr
            
            -- تسليط التوثيق على قائمة الخروج فوراً
            addExitLog(plr.Name, playerImgUrl, frozenTimeStr)
        end
    end)

    -- تتبع إعادة الدخول الدقيق بدلالة الـ UserId
    Players.PlayerAdded:Connect(function(plr)
        if targetUserId and plr.UserId == targetUserId then
            joins = joins + 1
            isTracking = true
            statsLabel.Text = "دخول: " .. joins .. "  |  خروج: " .. exits .. "   " .. formatTime(timerSeconds)
        end
    end)
end

