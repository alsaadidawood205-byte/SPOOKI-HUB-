-- 5. خوارزمية التخفيف الأقصى (Ultimate Rendering Reduction)
local function MaximizeFPS()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.ShadowSoftness = 0
    Lighting.Brightness = 1

    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("SunRaysEffect") or v:IsA("Sky") then
            v:Destroy()
        end
    end

    if workspace.Terrain then
        workspace.Terrain.WaterWaveSize = 0
        workspace.Terrain.WaterWaveSpeed = 0
        workspace.Terrain.WaterReflectance = 0
        workspace.Terrain.WaterTransparency = 1
    end

    local function IsPlayerPart(obj)
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character and obj:IsDescendantOf(player.Character) then
                return true
            end
        end
        return false
    end

    local function IsGround(obj)
        local name = string.lower(obj.Name)
        return name:find("baseplate") or name:find("ground") or name:find("floor") or obj == workspace.Terrain
    end

    local function PurgeObject(obj)
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
            if IsPlayerPart(obj) or IsGround(obj) then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
                obj.Transparency = 0
            else
                obj.Transparency = 1
                obj.CastShadow = false
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam") then
            obj.Enabled = false
        elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        elseif obj:IsA("Sound") then
            obj:Stop()
        end
    end

    for _, item in pairs(workspace:GetDescendants()) do
        pcall(PurgeObject, item)
    end

    workspace.DescendantAdded:Connect(function(newItem)
        pcall(PurgeObject, newItem)
    end)
end

pcall(MaximizeFPS)
