-- [ البرمجة والمنطق ]
-----------------------------------------------------------
local trackedPlayers = {} 
local joinCounts = {} 
local leaveCounts = {} 

local function UpdateLogUI(playerName, status, userId)
    for _, v in pairs(LogFrame:GetChildren()) do
        if v:IsA("Frame") and v.Name == playerName then v:Destroy() end
    end
    local entry = Instance.new("Frame", LogFrame)
    entry.Name = playerName
    entry.Size = UDim2.new(1, -5, 0, 60)
    entry.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    entry.BackgroundTransparency = 0.92
    Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 12)

    local pImage = Instance.new("ImageLabel", entry)
    pImage.Size = UDim2.new(0, 45, 0, 45)
    pImage.Position = UDim2.new(0.02, 0, 0.12, 0)
    pImage.Image = game:GetService("Players"):GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    pImage.BackgroundTransparency = 1
    Instance.new("UICorner", pImage).CornerRadius = UDim.new(1, 0)

    local pInfo = Instance.new("TextLabel", entry)
    pInfo.Size = UDim2.new(0.6, 0, 1, 0)
    pInfo.Position = UDim2.new(0.18, 5, 0, 0)
    local stateText = status == "متصل" and "🟢" or "🔴"
    
    pInfo.Text = playerName .. " " .. stateText .. "\nدخول: " .. (joinCounts[userId] or 0) .. " | خروج: " .. (leaveCounts[userId] or 0)
    pInfo.TextColor3 = Color3.fromRGB(255, 255, 255)
    pInfo.BackgroundTransparency = 1
    pInfo.Font = Enum.Font.GothamSemibold
    pInfo.TextSize = 12
    pInfo.TextXAlignment = Enum.TextXAlignment.Left

    if status == "متصل" then
        local pCounter = Instance.new("TextLabel", entry)
        pCounter.Size = UDim2.new(0.25, 0, 1, 0)
        pCounter.Position = UDim2.new(0.75, 0, 0, 0)
        pCounter.BackgroundTransparency = 1
        pCounter.TextColor3 = Color3.fromRGB(255, 255, 255)
        pCounter.Font = Enum.Font.Code
        pCounter.TextSize = 13
        local pStart = os.time()
        task.spawn(function()
            while entry.Parent and status == "متصل" do
                local d = os.time() - pStart
                pCounter.Text = string.format("%02d:%02d:%02d", math.floor(d/3600), math.floor((d%3600)/60), d%60)
                task.wait(1)
            end
        end)
    end
end

-- تشغيل عداد الوقت الرئيسي
local start = os.time()
task.spawn(function()
    while task.wait(1) do
        local d = os.time() - start
        SamlaTimer.Text = string.format("%02d:%02d:%02d", math.floor(d/3600), math.floor((d%3600)/60), d%60)
    end
end)

-- المنطق الجديد لزر التأكيد
ConfirmBtn.MouseButton1Click:Connect(function()
    local text = TargetInput.Text:lower()
    for _, p in pairs(game.Players:GetPlayers()) do
        if p.Name:lower():match(text) then
            trackedPlayers[p.UserId] = p.Name
            
            -- عند الضغط على تأكيد، نزيد عداد الخروج مباشرة
            leaveCounts[p.UserId] = (leaveCounts[p.UserId] or 0) + 1
            
            -- تحديث الواجهة فوراً لتظهر النتيجة
            UpdateLogUI(p.Name, "متصل", p.UserId)
            break
        end
    end
end)

game.Players.PlayerAdded:Connect(function(p)
    if trackedPlayers[p.UserId] then
        joinCounts[p.UserId] = (joinCounts[p.UserId] or 0) + 1
        UpdateLogUI(p.Name, "متصل", p.UserId)
    end
end)

game.Players.PlayerRemoving:Connect(function(p)
    if trackedPlayers[p.UserId] then
        leaveCounts[p.UserId] = (leaveCounts[p.UserId] or 0) + 1
        UpdateLogUI(p.Name, "خرج", p.UserId)
    end
end)

ToggleBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)
